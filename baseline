cy(arch_index: int) -> float:\n","    \"\"\"Returns latency (ms) for the configured platform and dataset.\"\"\"\n","    return float(hw_api.query_by_index(arch_index, DATASET)[LATENCY_KEY])\n","\n","\n","print(f\"\\nArch 0 — accuracy: {get_accuracy(0):.2f}%  latency: {get_latency(0):.4f} ms\")"]},{"cell_type":"markdown","id":"36f5378e","metadata":{"papermill":{"duration":0.003891,"end_time":"2026-04-11T10:16:14.334943+00:00","exception":false,"start_time":"2026-04-11T10:16:14.331052+00:00","status":"completed"},"tags":[]},"source":["## 4 · Exhaustive search\n","\n","Every architecture in the NAS-Bench-201 search space is evaluated.\n","Accuracy is an instant CSV lookup; latency is a pickle query (~80 k arch/s on Kaggle)."]},{"cell_type":"code","execution_count":5,"id":"dff30ca2","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:14.345884Z","iopub.status.busy":"2026-04-11T10:16:14.345538Z","iopub.status.idle":"2026-04-11T10:16:14.585243Z","shell.execute_reply":"2026-04-11T10:16:14.584246Z"},"papermill":{"duration":0.246777,"end_time":"2026-04-11T10:16:14.586661+00:00","exception":false,"start_time":"2026-04-11T10:16:14.339884+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["Exhaustive search — all architectures: 100%|██████████| 15625/15625 [00:00<00:00, 74990.33it/s]"]},{"name":"stdout","output_type":"stream","text":["       arch_index  accuracy   latency\n","0               0     81.90  0.957181\n","1               1     90.63  1.438988\n","2               2     81.93  2.030067\n","3               3     83.78  0.389997\n","4               4     84.44  0.698665\n","...           ...       ...       ...\n","15620       15620     83.94  0.352791\n","15621       15621     85.15 -1.000000\n","15622       15622     89.13  1.105549\n","15623       15623     66.08 -1.000000\n","15624       15624     83.58  0.646889\n","\n","[15625 rows x 3 columns]\n","Time taken: 0.2331 seconds\n","\n","Evaluated : 15625 / 15625 architectures (100%)\n","Accuracy  : 10.00% – 91.49%\n","Latency   : -1.0000 – 2.2381 ms\n"]},{"name":"stderr","output_type":"stream","text":["\n"]}],"source":["start_time = time.time()  # record start\n","results = []\n","\n","for idx in tqdm(range(SEARCH_SPACE_SIZE), desc=\"Exhaustive search — all architectures\"):\n","    results.append({\n","        \"arch_index\" : idx,\n","        \"accuracy\"   : get_accuracy(idx),   # instant — CSV lookup\n","        \"latency\"    : get_latency(idx),     # pickle lookup\n","    })\n","\n","df = pd.DataFrame(results)\n","print(df)\n","\n","assert len(df) == SEARCH_SPACE_SIZE, (\n","    f\"Expected {SEARCH_SPACE_SIZE} rows, got {len(df)}\"\n",")\n","\n","end_time = time.time()  # record end\n","elapsed = end_time - start_time\n","print(f\"Time taken: {elapsed:.4f} seconds\")\n","\n","print(f\"\\nEvaluated : {len(df)} / {SEARCH_SPACE_SIZE} architectures (100%)\")\n","print(f\"Accuracy  : {df['accuracy'].min():.2f}% – {df['accuracy'].max():.2f}%\")\n","print(f\"Latency   : {df['latency'].min():.4f} – {df['latency'].max():.4f} ms\")"]},{"cell_type":"code","execution_count":6,"id":"26c540e9","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:14.597366Z","iopub.status.busy":"2026-04-11T10:16:14.597088Z","iopub.status.idle":"2026-04-11T10:16:14.604847Z","shell.execute_reply":"2026-04-11T10:16:14.604085Z"},"papermill":{"duration":0.016402,"end_time":"2026-04-11T10:16:14.607288+00:00","exception":false,"start_time":"2026-04-11T10:16:14.590886+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Invalid latency (-1.0) : 4699 / 15625\n","Valid latency          : 10926 / 15625\n","Invalid %              : 30.07%\n"]}],"source":["invalid_count = (df[\"latency\"] == -1.0).sum()\n","valid_count   = (df[\"latency\"] > 0).sum()\n","\n","print(f\"Invalid latency (-1.0) : {invalid_count} / {len(df)}\")\n","print(f\"Valid latency          : {valid_count} / {len(df)}\")\n","print(f\"Invalid %              : {invalid_count / len(df) * 100:.2f}%\")"]},{"cell_type":"code","execution_count":7,"id":"e1d3f47b","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:14.618142Z","iopub.status.busy":"2026-04-11T10:16:14.617816Z","iopub.status.idle":"2026-04-11T10:16:14.629323Z","shell.execute_reply":"2026-04-11T10:16:14.628026Z"},"papermill":{"duration":0.01883,"end_time":"2026-04-11T10:16:14.63104+00:00","exception":false,"start_time":"2026-04-11T10:16:14.61221+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Time taken: 0.0051 seconds\n","\n"," BEST ARCHITECTURE (EXHAUSTIVE SEARCH)\n","Index    : 11226.0\n","Accuracy : 91.0000\n","Latency  : -1.0000\n","Score    : 0.4970\n"]}],"source":["# ─────────────────────────────────────────────\n","# Select BEST architecture from exhaustive search\n","# ─────────────────────────────────────────────\n","\n","import numpy as np\n","\n","# 1. Normalize\n","def normalize(x):\n","    return (x - x.min()) / (x.max() - x.min() + 1e-8)\n","\n","start_time = time.time()  \n","\n","df[\"acc_norm\"] = normalize(df[\"accuracy\"])\n","df[\"lat_norm\"] = normalize(df[\"latency\"])\n","\n","# 2. Trade-off parameter\n","alpha = 0.5   # change this if needed\n","\n","# 3. Score (maximize accuracy, minimize latency)\n","df[\"score\"] = alpha * df[\"acc_norm\"] - (1 - alpha) * df[\"lat_norm\"]\n","\n","# 4. Select best\n","best = df.loc[df[\"score\"].idxmax()]\n","end_time = time.time()  # record end\n","elapsed = end_time - start_time\n","print(f\"Time taken: {elapsed:.4f} seconds\")\n","\n","print(\"\\n BEST ARCHITECTURE (EXHAUSTIVE SEARCH)\")\n","print(f\"Index    : {best['arch_index']}\")\n","print(f\"Accuracy : {best['accuracy']:.4f}\")\n","print(f\"Latency  : {best['latency']:.4f}\")\n","print(f\"Score    : {best['score']:.4f}\")"]},{"cell_type":"markdown","id":"293b7d6e","metadata":{"papermill":{"duration":0.004027,"end_time":"2026-04-11T10:16:14.639875+00:00","exception":false,"start_time":"2026-04-11T10:16:14.635848+00:00","status":"completed"},"tags":[]},"source":["## 5 · Pareto front computation"]},{"cell_type":"code","execution_count":8,"id":"dfd65a2e","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:14.649615Z","iopub.status.busy":"2026-04-11T10:16:14.649332Z","iopub.status.idle":"2026-04-11T10:16:15.007792Z","shell.execute_reply":"2026-04-11T10:16:15.006848Z"},"papermill":{"duration":0.365619,"end_time":"2026-04-11T10:16:15.009498+00:00","exception":false,"start_time":"2026-04-11T10:16:14.643879+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Time taken: 0.3479 seconds\n","Pareto front size : 5 / 15625 evaluated\n","Best accuracy     : 91.49%\n","Best latency      : -1.0000 ms\n"," arch_index  accuracy   latency  acc_norm  lat_norm    score\n","       9930     91.49  1.475253  1.000000  0.764425 0.117787\n","       1459     91.46  1.268000  0.999632  0.700420 0.149606\n","      11400     91.40  0.993977  0.998896  0.615794 0.191551\n","      13778     91.22  0.909618  0.996687  0.589742 0.203472\n","      11226     91.00 -1.000000  0.993987  0.000000 0.496993\n"]}],"source":["def compute_pareto_front(df: pd.DataFrame) -> pd.DataFrame:\n","    \"\"\"\n","    Returns the Pareto-optimal subset of df.\n","\n","    Objectives: maximize accuracy, minimize latency.\n","    A solution i is dominated if there exists j such that:\n","        acc[j] >= acc[i]  AND  lat[j] <= lat[i]\n","        with at least one strict inequality.\n","\n","    Complexity: O(n²) via NumPy broadcasting — fast enough for n=15 625.\n","    \"\"\"\n","    pareto_mask = np.ones(len(df), dtype=bool)\n","    acc = df[\"accuracy\"].values\n","    lat = df[\"latency\"].values\n","\n","    for i in range(len(df)):\n","        if not pareto_mask[i]:\n","            continue\n","        dominated = (\n","            (acc >= acc[i]) & (lat <= lat[i]) &\n","            ((acc > acc[i]) | (lat < lat[i]))\n","        )\n","        dominated[i] = False   # a solution cannot dominate itself\n","        if dominated.any():\n","            pareto_mask[i] = False\n","\n","    return (\n","        df[pareto_mask]\n","        .sort_values(\"accuracy\", ascending=False)\n","        .reset_index(drop=True)\n","    )\n","\n","\n","def hypervolume_2d(pareto_df: pd.DataFrame, ref_point: tuple) -> float:\n","    \"\"\"\n","    Computes the 2-D hypervolume indicator.\n","\n","    Parameters\n","    ----------\n","    pareto_df : DataFrame with columns 'accuracy' and 'latency'\n","    ref_point : (ref_latency, ref_accuracy) — must be worse than every\n","                Pareto point (higher latency, lower accuracy).\n","\n","    Returns\n","    -------\n","    float — hypervolume indicator (higher is better)\n","    \"\"\"\n","    ref_lat, ref_acc = ref_point\n","\n","    # Use explicit column names — never rely on positional indices.\n","    pts = (\n","        pareto_df[[\"accuracy\", \"latency\"]]\n","        .sort_values(\"latency\")   # sweep left-to-right in latency\n","        .values\n","    )\n","\n","    hv = 0.0\n","    prev_lat = ref_lat\n","    for acc, lat in pts:\n","        if acc > ref_acc and lat < prev_lat:\n","            hv += (prev_lat - lat) * (acc - ref_acc)\n","            prev_lat = lat\n","    return hv\n","\n","start_time = time.time()  # record start\n","\n","pareto_df = compute_pareto_front(df)\n","\n","end_time = time.time()  # record end\n","elapsed = end_time - start_time\n","print(f\"Time taken: {elapsed:.4f} seconds\")\n","\n","print(f\"Pareto front size : {len(pareto_df)} / {len(df)} evaluated\")\n","print(f\"Best accuracy     : {pareto_df['accuracy'].max():.2f}%\")\n","print(f\"Best latency      : {pareto_df['latency'].min():.4f} ms\")\n","print(pareto_df.to_string(index=False))"]},{"cell_type":"markdown","id":"142f292b","metadata":{"papermill":{"duration":0.004226,"end_time":"2026-04-11T10:16:15.01827+00:00","exception":false,"start_time":"2026-04-11T10:16:15.014044+00:00","status":"completed"},"tags":[]},"source":["## 6 · Hypervolume indicator"]},{"cell_type":"code","execution_count":9,"id":"f4edaded","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:15.028432Z","iopub.status.busy":"2026-04-11T10:16:15.028138Z","iopub.status.idle":"2026-04-11T10:16:15.035026Z","shell.execute_reply":"2026-04-11T10:16:15.034251Z"},"papermill":{"duration":0.014022,"end_time":"2026-04-11T10:16:15.036709+00:00","exception":false,"start_time":"2026-04-11T10:16:15.022687+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Hypervolume (ref=(2.46 ms, 9.00%)) : 283.8728\n"]}],"source":["# Reference point: slightly worse than the worst solution on each axis\n","ref_lat = df[\"latency\"].max()  * 1.1\n","ref_acc = df[\"accuracy\"].min() * 0.9\n","\n","hv = hypervolume_2d(pareto_df, ref_point=(ref_lat, ref_acc))\n","print(f\"Hypervolume (ref=({ref_lat:.2f} ms, {ref_acc:.2f}%)) : {hv:.4f}\")"]},{"cell_type":"markdown","id":"f76d709a","metadata":{"papermill":{"duration":0.004414,"end_time":"2026-04-11T10:16:15.045702+00:00","exception":false,"start_time":"2026-04-11T10:16:15.041288+00:00","status":"completed"},"tags":[]},"source":["## 7 · Visualisation"]},{"cell_type":"code","execution_count":10,"id":"f2e8a8d8","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:15.05584Z","iopub.status.busy":"2026-04-11T10:16:15.055476Z","iopub.status.idle":"2026-04-11T10:16:16.117181Z","shell.execute_reply":"2026-04-11T10:16:16.115941Z"},"papermill":{"duration":1.069584,"end_time":"2026-04-11T10:16:16.119416+00:00","exception":false,"start_time":"2026-04-11T10:16:15.049832+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1400x500 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Plot saved to /kaggle/working/pareto_front.png\n"]}],"source":["fig, axe