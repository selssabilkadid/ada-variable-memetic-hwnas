_time = time.time() \n","df[\"acc_norm\"] = normalize(df[\"accuracy\"])\n","df[\"lat_norm\"] = normalize(df[\"latency\"])\n","\n","# 2. Define ideal point\n","\n","ideal_acc = max(df[\"acc_norm\"])\n","ideal_lat = min(df[\"lat_norm\"])\n","\n","# 3. Compute distance to ideal point\n","df[\"distance_to_ideal\"] = np.sqrt(\n","    (df[\"acc_norm\"] - ideal_acc) ** 2 +\n","    (df[\"lat_norm\"] - ideal_lat) ** 2\n",")\n","\n","# 4. Select best (minimum distance)\n","best = df.loc[df[\"distance_to_ideal\"].idxmin()]\n","\n","end_time = time.time()  # record end\n","elapsed = end_time - start_time\n","print(f\"Time taken: {elapsed:.4f} seconds\")\n","\n","print(\"\\n BEST ARCHITECTURE (Distance to Ideal Point)\")\n","print(f\"Index    : {best['arch_index']}\")\n","print(f\"Accuracy : {best['accuracy']:.4f}\")\n","print(f\"Latency  : {best['latency']:.4f}\")\n","print(f\"Distance : {best['distance_to_ideal']:.6f}\")\n","\n","# 5. Show top 10 closest architectures\n","print(\"\\n Top 10 closest to ideal:\")\n","display(df.sort_values(by=\"distance_to_ideal\").head(10))"]},{"cell_type":"markdown","id":"ba41dcc4","metadata":{"papermill":{"duration":0.007,"end_time":"2026-04-11T10:16:16.290305+00:00","exception":false,"start_time":"2026-04-11T10:16:16.283305+00:00","status":"completed"},"tags":[]},"source":["---\n","## 9 · Full Grid Search — All Datasets × All Devices\n","\n","Runs the exhaustive Pareto search for **every combination** of dataset and hardware platform.  \n","Results are saved as:\n","- `results/<dataset>/<platform>/search_results.csv`\n","- `results/<dataset>/<platform>/pareto_front.csv`\n","- `results/<dataset>/<platform>/pareto_front.png`\n","- `results/<dataset>/summary_table.csv` — per-dataset comparison across all platforms\n","- `results/global_summary.csv` — all combinations in one table\n"]},{"cell_type":"code","execution_count":13,"id":"576a411b","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:16.303509Z","iopub.status.busy":"2026-04-11T10:16:16.303217Z","iopub.status.idle":"2026-04-11T10:16:16.318013Z","shell.execute_reply":"2026-04-11T10:16:16.316864Z"},"papermill":{"duration":0.023211,"end_time":"2026-04-11T10:16:16.319351+00:00","exception":false,"start_time":"2026-04-11T10:16:16.29614+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Grid will cover:\n","  Datasets  : ['cifar10', 'cifar100', 'ImageNet16-120']\n","  Platforms : ['raspi4', 'edgegpu', 'edgetpu', 'pixel3', 'eyeriss', 'fpga']\n","  Total runs: 18\n"]}],"source":["# ─────────────────────────────────────────────────────────────────────────────\n","# 9 · Full Grid Search — All Datasets × All Devices\n","# ─────────────────────────────────────────────────────────────────────────────\n","import os, json, time, warnings\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import matplotlib.patches as mpatches\n","from tqdm import tqdm\n","\n","warnings.filterwarnings(\"ignore\")\n","\n","DATASETS   = [\"cifar10\", \"cifar100\", \"ImageNet16-120\"]\n","PLATFORMS  = [\"raspi4\", \"edgegpu\", \"edgetpu\", \"pixel3\", \"eyeriss\", \"fpga\"]\n","BASE_DIR   = \"/kaggle/working/results\"\n","os.makedirs(BASE_DIR, exist_ok=True)\n","\n","# ── Helpers (same logic as cells above, self-contained) ──────────────────────\n","\n","def _normalize(x):\n","    return (x - x.min()) / (x.max() - x.min() + 1e-8)\n","\n","def _compute_pareto_front(df_in):\n","    mask = np.ones(len(df_in), dtype=bool)\n","    acc  = df_in[\"accuracy\"].values\n","    lat  = df_in[\"latency\"].values\n","    for i in range(len(df_in)):\n","        if not mask[i]:\n","            continue\n","        dominated = (acc >= acc[i]) & (lat <= lat[i]) & ((acc > acc[i]) | (lat < lat[i]))\n","        dominated[i] = False\n","        if dominated.any():\n","            mask[i] = False\n","    return df_in[mask].sort_values(\"accuracy\", ascending=False).reset_index(drop=True)\n","\n","def _hypervolume_2d(pareto_df, ref_point):\n","    ref_lat, ref_acc = ref_point\n","    pts = pareto_df[[\"accuracy\", \"latency\"]].sort_values(\"latency\").values\n","    hv, prev_lat = 0.0, ref_lat\n","    for acc, lat in pts:\n","        if acc > ref_acc and lat < prev_lat:\n","            hv += (prev_lat - lat) * (acc - ref_acc)\n","            prev_lat = lat\n","    return hv\n","\n","def _best_by_weighted_score(df_in, alpha=0.5):\n","    d = df_in.copy()\n","    d[\"acc_norm\"] = _normalize(d[\"accuracy\"])\n","    d[\"lat_norm\"] = _normalize(d[\"latency\"])\n","    d[\"score\"]    = alpha * d[\"acc_norm\"] - (1 - alpha) * d[\"lat_norm\"]\n","    return d.loc[d[\"score\"].idxmax()]\n","\n","def _best_by_ideal_distance(df_in):\n","    d = df_in.copy()\n","    d[\"acc_norm\"] = _normalize(d[\"accuracy\"])\n","    d[\"lat_norm\"] = _normalize(d[\"latency\"])\n","    d[\"dist\"]     = np.sqrt((d[\"acc_norm\"] - 1) ** 2 + (d[\"lat_norm\"] - 0) ** 2)\n","    return d.loc[d[\"dist\"].idxmin()]\n","\n","def run_one(dataset, platform, hw_api_inst, acc_df_full):\n","    \"\"\"Run exhaustive search for one (dataset, platform) pair.\"\"\"\n","    latency_key = f\"{platform}_latency\"\n","\n","    # Validate keys exist\n","    sample = hw_api_inst.query_by_index(0, dataset)\n","    if latency_key not in sample:\n","        return None, f\"Key '{latency_key}' missing for dataset='{dataset}'\"\n","\n","    acc_col = f\"acc_{dataset}\"\n","    if acc_col not in acc_df_full.columns:\n","        return None, f\"Column '{acc_col}' missing in accuracy CSV\"\n","\n","    results = []\n","    for idx in range(SEARCH_SPACE_SIZE):\n","        results.append({\n","            \"arch_index\": idx,\n","            \"accuracy\":   float(acc_df_full.loc[idx, acc_col]),\n","            \"latency\":    float(hw_api_inst.query_by_index(idx, dataset)[latency_key]),\n","        })\n","\n","    df_res = pd.DataFrame(results)\n","    pareto = _compute_pareto_front(df_res)\n","    ref    = (df_res[\"latency\"].max() * 1.1, df_res[\"accuracy\"].min() * 0.9)\n","    hv     = _hypervolume_2d(pareto, ref)\n","    best_s = _best_by_weighted_score(df_res)\n","    best_d = _best_by_ideal_distance(df_res)\n","\n","    out = {\n","        \"df\":        df_res,\n","        \"pareto\":    pareto,\n","        \"hv\":        hv,\n","        \"best_score\": best_s,\n","        \"best_dist\":  best_d,\n","        \"latency_key\": latency_key,\n","    }\n","    return out, None\n","\n","print(\"Grid will cover:\")\n","print(f\"  Datasets  : {DATASETS}\")\n","print(f\"  Platforms : {PLATFORMS}\")\n","print(f\"  Total runs: {len(DATASETS) * len(PLATFORMS)}\")\n"]},{"cell_type":"code","execution_count":14,"id":"cdc3f931","metadata":{"execution":{"iopub.execute_input":"2026-04-11T10:16:16.334205Z","iopub.status.busy":"2026-04-11T10:16:16.333933Z","iopub.status.idle":"2026-04-11T10:16:25.050235Z","shell.execute_reply":"2026-04-11T10:16:25.048916Z"},"papermill":{"duration":8.725781,"end_time":"2026-04-11T10:16:25.051942+00:00","exception":false,"start_time":"2026-04-11T10:16:16.326161+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","============================================================\n","  Running : cifar10 / raspi4\n","============================================================\n","  Architectures : 15625\n","  Pareto size   : 43\n","  Hypervolume   : 108.7650\n","  Best (score)  : arch 2649  acc=87.24%  lat=5.2035 ms\n","  Best (ideal)  : arch 2649  acc=87.24%  lat=5.2035 ms\n","  Time          : 0.5 s\n","\n","============================================================\n","  Running : cifar10 / edgegpu\n","============================================================\n","  Architectures : 15625\n","  Pareto size   : 23\n","  Hypervolume   : 12.3606\n","  Best (score)  : arch 8207  acc=88.79%  lat=1.7697 ms\n","  Best (ideal)  : arch 6950  acc=88.35%  lat=1.7385 ms\n","  Time          : 0.5 s\n","\n","=====================